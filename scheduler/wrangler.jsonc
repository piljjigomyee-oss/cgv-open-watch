{
  "name": "cgv-open-watch-scheduler",
  "main": "worker.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *", "*/2 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cgv-open-watch",
      "database_id": "0fda2781-de00-4114-bfc2-ff5349795b9c",
      "migrations_dir": "migrations"
    }
  ],
"vars": {
  "GITHUB_OWNER": "piljjigomyee-oss",
  "GITHUB_REPO": "cgv-open-watch",
  "GITHUB_WORKFLOW": "watch.yml",
  "GITHUB_REF": "main"
}
